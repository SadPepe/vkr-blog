# Шаблон для публичного стенда. Скопируйте в .env:
#   Copy-Item .env.production.example .env
# Файл не читается автоматически: docker-compose использует только .env.
# Инструкция: docs/home-hosting.md

APP_NAME="МОЙ.БЛОГ"
APP_ENV=production
# Сгенерируйте ключ и вставьте сюда, иначе он будет временным:
#   docker compose exec app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.ru

# Наружу отдаёт Caddy; 8080 не должен слушать все интерфейсы.
APP_BIND=127.0.0.1

# HTTPS: домен, A-запись которого указывает на ваш публичный IP.
APP_DOMAIN=example.ru
ACME_EMAIL=admin@example.ru

# Закрытая бета: noindex. Перед публичным запуском — false.
PRIVATE_BETA=true
# Пусто — регистрация открыта.
REGISTRATION_INVITE_CODE=

# Обязательно true при HTTPS, иначе cookie не отправятся.
SESSION_SECURE_COOKIE=true

# Реквизиты оператора персональных данных (см. config/legal.php).
LEGAL_OPERATOR="Физическое лицо [ФИО]"
LEGAL_EMAIL=privacy@example.ru
LEGAL_DOMAIN=example.ru
LEGAL_VERSION=1.0
LEGAL_UPDATED_AT=05.11.2026

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Пароль должен совпадать у app и db. Если том db уже создан, смена пароля
# здесь не меняет его в PostgreSQL — сначала ALTER USER (docs/home-hosting.md).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=blog
DB_USERNAME=blog
DB_PASSWORD=change-me-long-random-password

# Демо-данные: true только при первом запуске, если нужны статьи.
DB_SEED=false
# SEEDER_IMAGES_DIR=
# SEEDER_ARTICLES_COUNT=40

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Российский SMTP-провайдер: зарубежная почта нарушает локализацию.
# Яндекс: smtp.yandex.ru, 465, smtps, пароль приложения (не обычный пароль).
# Для Mail.ru: smtp.mail.ru, 465, smtps.
MAIL_SCHEME=smtps
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=you@yandex.ru
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="you@yandex.ru"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
